{
  "name": "paisa-book",
  "version": "1.0.1",
  "private": true,
  "description": "Offline Android app for tracking spends, credit-card dues and interest, friend lending, and recurring bills (INR)",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "apk": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "deploy": "cd android && gradlew.bat installDebug",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "~6.2.0",
    "@capacitor/core": "~6.2.0",
    "@capacitor/filesystem": "~6.0.0",
    "@capacitor/share": "~6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "~6.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anilkaram/Finance_management_app.git"
  }
}
